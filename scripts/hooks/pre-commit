#!/bin/bash

set -euo pipefail

# shellcheck source=/dev/null
source "$(dirname "${BASH_SOURCE[0]}")/../../hooks_utility.sh"

echo "pre-commit" | hooks_utility_enter

# perform branch protection
hooks_utility_protect_branch

# ensure file modification  ----------------------------------------------------
# make sure CHANGELOG.md is edited when finish feature branch
hooks_utility_ensure_changelog_edited 'CHANGELOG.md'

# make sure version is bumped when finish feature branch
pattern='^# version: v[0-9.]+'
hooks_utility_ensure_version_updated 'hooks-utility.sh' "${pattern}"

# make sure hooks_utility.sh contains no AM
# TODO need test
if [[ $(get_commit_type_at_pre_commit) == "merge-binary-release" ]]; then
    PATTERN=
    "${PRIMARY_AM_PATTERN}|${SECONDARY_AM_PATTERN}|${TERTIARY_AM_PATTERN}"
    if git diff --cached --no-color | grep -E -q -- "$PATTERN"; then
        exit 1
    fi
fi

echo "pre-commit" | hooks_utility_pass

exit 0
