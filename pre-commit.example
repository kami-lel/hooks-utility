#!/bin/bash

set -euo pipefail

# shellcheck source=/dev/null
source "$(dirname "${BASH_SOURCE[0]}")/../hooks_utility/hooks_utility.sh"

printf "start pre-commit" | hooks_utility_debug

# perform branch protection
hooks_utility_protect_branch

# make sure CHANGELOG.md is edited
hooks_utility_ensure_file_modification "CHANGELOG.md" "merge-binary-finish_feature"
hooks_utility_ensure_file_modification "CHANGELOG.md" "merge-binary-release"

# Todo write example for version change

printf 'DONE pre-commit' | hooks_utility_info

exit 0
